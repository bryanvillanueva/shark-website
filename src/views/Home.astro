---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Marquee from '../components/Marquee.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import ServiceVisual from '../components/ServiceVisual.astro';
import ProjectCard from '../components/ProjectCard.astro';
import heroImg from '../assets/hero.png';
import { projects, routes, t, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const d = t[lang];
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} current="home">
  <section class="hero">
    <div class="hero-media"><Media src="/video/hero.mp4" poster={heroImg} /></div>
    <div class="wrap hero-inner">
      <span class="eyebrow" data-reveal style="color:var(--maya)">{d.hero.eyebrow}</span>
      <h1 data-split data-hero>
        <span class="line">{d.hero.line1}</span>
        <span class="line outline-text">{d.hero.line2}</span>
      </h1>
      <p class="sub" data-reveal data-delay="0.7">{d.hero.sub}</p>
      <div class="actions" data-reveal data-delay="0.9">
        <a class="btn white" data-magnetic href={routes.contact[lang]}>{d.hero.cta1}<Icon name="arrow" /></a>
        <a class="btn ghost" data-magnetic href={routes.portfolio[lang]}>{d.hero.cta2}</a>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span>{d.hero.scroll}</span><i></i></div>
  </section>

  <Marquee lang={lang} />

  <section class="section" id="services">
    <div class="wrap">
      <span class="eyebrow">{d.services.eyebrow}</span>
      <h2 class="h2" data-split>{d.services.title}</h2>
      <p class="lead" data-reveal style="margin-top:20px">{d.services.sub}</p>
      <div class="stack">
        {d.services.items.map((s, i) => (
          <article class="svc-card" style={`--i:${i}`} id={s.id}>
            <div>
              <div class="svc-num">{pad(i + 1)}</div>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
              <a class="arrow-link" href={`${routes.services[lang]}#${s.id}`}>{d.services.more}<i><Icon name="arrow" /></i></a>
            </div>
            <ServiceVisual id={s.id} alt={s.title} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="why section on-dark">
    <Media src="/video/network.mp4" />
    <div class="wrap">
      <span class="eyebrow">{d.why.eyebrow}</span>
      <h2 class="h2" data-split>{d.why.title}</h2>
      <div class="why-grid" data-reveal-group>
        {d.why.items.map(([h, p], i) => (
          <div class="why-item"><div class="n">{pad(i + 1)}</div><h3>{h}</h3><p>{p}</p></div>
        ))}
      </div>
      <div style="margin-top:56px" data-reveal><a class="btn white" data-magnetic href={routes.contact[lang]}>{d.why.cta}<Icon name="arrow" /></a></div>
    </div>
  </section>

  <section class="work section" style="padding-bottom:clamp(48px,6vw,96px)">
    <div class="wrap work-head">
      <div>
        <span class="eyebrow">{d.work.eyebrow}</span>
        <h2 class="h2" data-split>{d.work.title}</h2>
        <p class="lead" style="margin-top:16px" data-reveal>{d.work.sub}</p>
      </div>
      <a class="arrow-link" style="color:var(--shark)" href={routes.portfolio[lang]}>{d.work.view}<i><Icon name="arrow" /></i></a>
    </div>
    <div>
      <div class="hscroll" data-hscroll>
        <div class="htrack">{projects.map((p) => <ProjectCard lang={lang} p={p} />)}</div>
      </div>
      <div class="progress" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="impact section on-dark">
    <Media src="/video/dive.mp4" />
    <div class="wrap">
      <span class="eyebrow">{d.impact.eyebrow}</span>
      <h2 class="h2" data-split>{d.impact.title}</h2>
      <p data-reveal>{d.impact.body}</p>
      <a class="btn white" data-magnetic href={routes.about[lang]} data-reveal>{d.impact.cta}<Icon name="arrow" /></a>
    </div>
  </section>

  <Cta lang={lang} />
</Base>
