---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import Cta from '../components/Cta.astro';
import surfer from '../assets/surfer.png';
import { t, type Lang } from '../i18n/content';

const { lang } = Astro.props as { lang: Lang };
const d = t[lang].about;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} current="about">
  <PageHero eyebrow={d.eyebrow} title={d.title} sub={d.sub} />

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{d.visionTitle}</span>
        <p class="big-quote" data-split>{d.vision}</p>
        <p class="lead" style="margin-top:28px" data-reveal>{d.visionClose}</p>
      </div>
      <div class="timeline" data-reveal-group>
        <div class="tl-item"><h3>{d.v5[0]}</h3><p>{d.v5[1]}</p></div>
        <div class="tl-item"><h3>{d.v10[0]}</h3><p>{d.v10[1]}</p></div>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--maya-soft)">
    <div class="wrap split">
      <div class="surfer-wrap"><Image src={surfer} alt="" width={680} loading="lazy" data-parallax="0.05" /></div>
      <div>
        <span class="eyebrow">{d.missionTitle}</span>
        <h2 class="h2" data-split>{d.missionTitle}</h2>
        <div data-reveal-group style="display:grid;gap:18px;margin-top:24px">
          {d.mission.map((p) => <p class="lead">{p}</p>)}
        </div>
      </div>
    </div>
    <div class="wrap">
      <div class="pct" data-reveal>
        <b data-count={d.tenPct[0]}>{d.tenPct[0]}</b>
        <p>{d.tenPct[1]}</p>
      </div>
      <p class="lead" data-reveal>{d.missionClose}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">{d.valuesTitle}</span>
      <h2 class="h2" data-split>{d.valuesTitle}</h2>
      <div class="values" data-reveal-group>
        {d.values.map(([h, p], i) => <div class="value"><div class="n">{pad(i + 1)}</div><h3>{h}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section on-dark dark-section">
    <Media src="/video/network.mp4" />
    <div class="wrap stats" data-reveal-group>
      {d.stats.map(([n, l]) => <div class="stat"><b data-count={n}>{n}</b><span>{l}</span></div>)}
    </div>
  </section>

  <Cta lang={lang} />
</Base>
